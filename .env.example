# Set these environment variables in the shell before starting/building Re.Pack.
# Re.Pack does not automatically load this example file.

# Hosted Next.js course, independently deployed from jinnie-web.
# The native wrapper adds embed=native. This default applies in dev and release.
JINNIE_LEARN_URL=https://learn.jinnie.ph/

# Optional local jinnie-web course preview (start that repo on port 3010):
# JINNIE_LEARN_URL=http://localhost:3010/learn
# For Android over USB/emulator, also reverse tcp:3010 to tcp:3010.

# Separate origin for the native app catalog and federated containers.
JINNIE_CDN=https://sdk.jinnie.ph
# JINNIE_CDN=http://localhost:9020

# Cloudflare R2 bucket that `pnpm --filter @jinnie/host cdn:upload` publishes to.
# Real values go in a gitignored `.env` at the workspace root.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=jinnie
R2_PUBLIC_URL=https://cdn.jinnie.ph
