{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "node": "24.18.0",
      "env": {
        "JINNIE_CDN": "https://sdk.jinnie.ph"
      }
    },
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "android": {"buildType": "apk"},
      "ios": {"simulator": true}
    },
    "development": {
      "extends": "preview",
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug",
        "withoutCredentials": true
      },
      "ios": {"buildConfiguration": "Debug"}
    }
  },
  "submit": {
    "production": {}
  }
}
