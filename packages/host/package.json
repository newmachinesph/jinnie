{
  "name": "@jinnie/host",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "prebuild": "expo prebuild --clean",
    "android": "react-native run-android --no-packager",
    "ios": "react-native run-ios --no-packager",
    "cdn": "node ./scripts/cdn.mjs",
    "cdn:release": "node ./scripts/cdn.mjs --release",
    "cdn:pack": "node ./scripts/cdn-pack.mjs",
    "cdn:upload": "node ./scripts/cdn-upload.mjs",
    "assets:upload": "node ./scripts/assets-upload.mjs",
    "reverse": "node ./scripts/adb-reverse.mjs",
    "bundle:android": "react-native bundle --platform android --entry-file index.js --dev false --bundle-output build/android/index.bundle",
    "bundle:ios": "react-native bundle --platform ios --entry-file index.js --dev false --bundle-output build/ios/index.bundle",
    "typecheck": "tsc",
    "test:cdn": "node --test scripts/cdn.test.mjs"
  },
  "dependencies": {
    "@jinnie/sdk": "workspace:*",
    "@module-federation/enhanced": "catalog:",
    "@noble/ciphers": "catalog:",
    "@noble/hashes": "catalog:",
    "@react-native-async-storage/async-storage": "catalog:",
    "@react-native-community/netinfo": "catalog:",
    "@react-navigation/bottom-tabs": "catalog:",
    "@react-navigation/native": "catalog:",
    "@react-navigation/native-stack": "catalog:",
    "expo": "catalog:",
    "expo-application": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-document-picker": "catalog:",
    "expo-file-system": "catalog:",
    "expo-local-authentication": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-sharing": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-system-ui": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-edge-to-edge": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-webview": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/runtime": "catalog:",
    "@callstack/repack": "catalog:",
    "@callstack/repack-plugin-expo-modules": "catalog:",
    "@react-native-community/cli": "catalog:",
    "@react-native/babel-preset": "catalog:",
    "@react-native/typescript-config": "catalog:",
    "@rspack/core": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
